# Server Configuration
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/trustpay

# Stellar / Soroban Configuration
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org:443
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
HORIZON_URL=https://horizon-testnet.stellar.org

# Walletless Transactions Sponsor Account
# You get this by running: `./scripts/deploy.sh`
SPONSOR_SECRET_KEY=

# Contract IDs
# You get these from the output of `./scripts/deploy.sh`
ESCROW_CONTRACT_ID=
APPROVAL_CONTRACT_ID=
FEE_SPONSOR_CONTRACT_ID=

# (Optional fallback) For some routes reading NEXT_PUBLIC format in backend
NEXT_PUBLIC_ESCROW_CONTRACT_ID=
NEXT_PUBLIC_APPROVAL_CONTRACT_ID=
